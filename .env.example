# Copy to .env at the repository root and fill in your MySQL credentials.
# All four API servers and the scripts/ tools read this one file.
DB_HOST=localhost
# DB_PORT=3306   # optional; read by scripts/, the Node and the FastAPI servers
DB_USER=root
DB_PASSWORD=
DB_NAME=SmartUniversityDB

# Optional: port for the Node and FastAPI servers (default 8000).
# The dashboard calls http://localhost:8000 (API_BASE in apps/web/app.js).
# PORT=8000
